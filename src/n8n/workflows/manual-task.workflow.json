{
  "name": "Bukery: Telegram Command → Control Tower → Reply",
  "nodes": [
    {
      "parameters": {
        "updates": ["message", "callback_query"],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "credentials": { "telegramApi": { "id": "1", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message?.chat?.id?.toString() }}",
              "operation": "contains",
              "value2": "={{ $env.TELEGRAM_ALLOWED_GROUP }}"
            }
          ]
        }
      },
      "id": "group-check",
      "name": "Allowed Group?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message?.text ?? '' }}",
              "operation": "startsWith",
              "value2": "approve:"
            }
          ]
        }
      },
      "id": "is-approval",
      "name": "Is Patch Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONTROL_TOWER_URL }}/webhook/patch-decision",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ issueId: $json.callback_query?.data?.replace('approve:', '').replace('reject:', ''), approved: $json.callback_query?.data?.startsWith('approve:'), approvedBy: $json.callback_query?.from?.username }) }}",
        "options": {}
      },
      "id": "patch-decision",
      "name": "Send Patch Decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONTROL_TOWER_URL }}/webhook/task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.message?.text, chatId: $json.message?.chat?.id, messageId: $json.message?.message_id }) }}",
        "options": { "timeout": 90000 }
      },
      "id": "forward-task",
      "name": "Forward Task to Tower",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.reply }}",
        "additionalFields": {
          "parse_mode": "MarkdownV2",
          "reply_to_message_id": "={{ $json.messageId }}"
        }
      },
      "id": "telegram-reply",
      "name": "Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1200, 400],
      "credentials": { "telegramApi": { "id": "1", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[ { "node": "Allowed Group?", "type": "main", "index": 0 } ]]
    },
    "Allowed Group?": {
      "main": [
        [ { "node": "Is Patch Approval?", "type": "main", "index": 0 } ]
      ]
    },
    "Is Patch Approval?": {
      "main": [
        [ { "node": "Send Patch Decision", "type": "main", "index": 0 } ],
        [ { "node": "Forward Task to Tower", "type": "main", "index": 0 } ]
      ]
    },
    "Forward Task to Tower": {
      "main": [[ { "node": "Telegram Reply", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["bukery", "telegram", "manual"]
}
