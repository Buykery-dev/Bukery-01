{
  "agents": {
    "enabled": ["claude", "claude-code", "codex", "gpt"],
    "disabled": ["cursor"],
    "roles": {
      "control-tower": "claude-code",
      "patch-executor": "codex",
      "secondary-reviewer": ["claude", "gpt"],
      "designer": "cursor"
    }
  },
  "routing": {
    "defaultMode": "single-best",
    "maxConcurrent": 3,
    "taskTypeOverrides": {
      "code":     { "preferred": ["claude-code", "codex", "gpt"] },
      "analysis": { "preferred": ["claude", "gpt"] },
      "creative": { "preferred": ["gpt", "claude"] },
      "general":  { "preferred": ["claude", "gpt"] }
    },
    "issueRouting": {
      "smallPatch":     "codex",
      "complexChange":  "claude-code",
      "investigateOnly":["claude", "gpt"]
    }
  },
  "evaluation": {
    "weights": {
      "completeness": 0.4,
      "clarity": 0.3,
      "length": 0.15,
      "latency": 0.15
    }
  },
  "budgets": {
    "daily": {
      "total": 5.00,
      "perAgent": {
        "gpt": 2.00,
        "codex": 1.00,
        "claude": 2.00,
        "claude-code": 2.00
      }
    },
    "monthly": {
      "total": 50.00
    }
  },
  "n8n": {
    "webhookPort": 3000,
    "webhookSecret": "${WEBHOOK_SECRET}",
    "flows": {
      "alertToIssue":   "src/n8n/workflows/alert-to-issue.workflow.json",
      "codexPatch":     "src/n8n/workflows/codex-patch.workflow.json",
      "manualTask":     "src/n8n/workflows/manual-task.workflow.json"
    }
  },
  "issueQueue": {
    "persistPath": "./issue-queue.json",
    "cooldownMs": 300000,
    "maxRetries": 3
  },
  "observability": {
    "recentLogLines": 20,
    "alertSeverityThreshold": "low"
  }
}
