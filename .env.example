# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic API Key (for Claude and Claude Code)
ANTHROPIC_API_KEY=

# OpenAI API Key (for Codex and GPT-4)
OPENAI_API_KEY=

# Cursor API Key (stub — not yet publicly available)
CURSOR_API_KEY=

# Optional: Log level (trace|debug|info|warn|error) — defaults to info
LOG_LEVEL=info

# Optional: Cost ledger file path — defaults to ./cost-ledger.json
COST_LEDGER_PATH=./cost-ledger.json

# n8n Webhook Server (inbound — receives from n8n/OpenClo)
WEBHOOK_SECRET=change-me-to-a-random-secret
WEBHOOK_PORT=3000

# Control Tower URL (where n8n sends inbound webhooks)
CONTROL_TOWER_URL=http://localhost:3000

# n8n instance
N8N_URL=http://localhost:5678
TELEGRAM_ALERT_CHAT_ID=    # Telegram chat/group ID to send issue alerts to
TELEGRAM_ALLOWED_GROUP=    # Same as openclaw.json groupAllowFrom (for n8n flows)

# n8n outbound webhook URLs (Control Tower triggers these)
N8N_WEBHOOK_CODEX_PATCH=
N8N_WEBHOOK_REVIEW_REQUEST=
N8N_WEBHOOK_MERGE_APPROVAL=
N8N_WEBHOOK_PATCH_REJECTED=

# GitHub (used by n8n Codex Patch flow)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
